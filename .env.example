DATABASE_URL="postgresql://appointly_local:appointly_local@localhost:5432/appointly?schema=public"

# Separate disposable test database from docker-compose.yml (port 5433 / appointly_test).
# `npm test` provisions an isolated temporary database automatically when this is blank.
DATABASE_URL_TEST="postgresql://appointly_test:appointly_test_local_only@localhost:5433/appointly_test?schema=public"

# Optional: created by `npm run db:seed` when both values are present.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_PHONE=

# Public URL used in verification and payment links.
APP_URL=http://localhost:3000

AUTH_TOKEN_SECRET=
# Resend email delivery (verification, booking notifications, and admin MFA).
RESEND_API_KEY=
EMAIL_FROM=

# Twilio SMS delivery (only users who opted in to SMS receive messages).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Razorpay. Configure the webhook URL as https://<host>/api/webhooks/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Bearer secret for the scheduled notification/booking-expiration worker.
CRON_SECRET=
