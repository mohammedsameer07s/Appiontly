generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@appointly/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum AccountTokenPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
}

enum PaymentStatus {
  PENDING
  PAID
  REFUND_PENDING
  REFUNDED
  FAILED
  NOT_REQUIRED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  active       Boolean    @default(true)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  smsNotificationsEnabled Boolean @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  businesses   Business[]
  bookings     Booking[]  @relation("CustomerBookings")
  reviews      Review[]
  auditEntries AuditLog[] @relation("AuditActor")
  accountTokens AccountToken[]
  mfaChallenges AdminMfaChallenge[]

  @@index([role, active])
}

model AccountToken {
  id        String             @id @default(cuid())
  userId    String
  purpose   AccountTokenPurpose
  tokenHash String             @unique
  attempts  Int                @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model AdminMfaChallenge {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model LoginThrottle {
  id              String    @id @default(cuid())
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?

  @@index([windowStartedAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Category {
  id         String     @id @default(cuid())
  name       String     @unique
  slug       String     @unique
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  businesses Business[]
}

model Business {
  id           String         @id @default(cuid())
  ownerId      String
  categoryId   String
  name         String
  city         String
  latitude     Float?
  longitude    Float?
  timezone     String         @default("Asia/Kolkata")
  address      String
  description  String
  status       BusinessStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  services     Service[]
  availability Availability[]
  scheduleExceptions ScheduleException[]
  bookings     Booking[]
  reviews      Review[]

  @@index([status, categoryId, city])
  @@index([ownerId])
}

model Service {
  id              String    @id @default(cuid())
  businessId      String
  name            String
  description     String    @default("")
  priceCents      Int
  durationMinutes Int
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@unique([businessId, name])
  @@index([businessId, active])
}

model Availability {
  id            String   @id @default(cuid())
  businessId    String
  weekday       Int
  openingMinute Int
  closingMinute Int
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, weekday, openingMinute])
}

model ScheduleException {
  id         String                  @id @default(cuid())
  businessId String
  date       DateTime                @db.Date
  isClosed   Boolean                 @default(false)
  business   Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shifts     ScheduleExceptionShift[]

  @@unique([businessId, date])
  @@index([businessId, date])
}

model ScheduleExceptionShift {
  id                   String            @id @default(cuid())
  exceptionId          String
  openingMinute        Int
  closingMinute        Int
  exception            ScheduleException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)

  @@index([exceptionId, openingMinute])
}

model Booking {
  id              String        @id @default(cuid())
  customerId      String
  businessId      String
  serviceId       String
  date            DateTime      @db.Date
  timezone        String
  startMinute     Int
  durationMinutes Int
  priceCents      Int
  details         String        @default("")
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  review          Review?
  payment         Payment?

  @@index([customerId, date, status])
  @@index([businessId, date, status])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  amountPaise       Int
  status            PaymentStatus @default(PENDING)
  refundEligible    Boolean       @default(false)
  bookingCancelledAt DateTime?
  paymentLinkId     String?       @unique
  paymentLinkUrl    String?
  linkCreationStartedAt DateTime?
  externalPaymentId String?       @unique
  refundId          String?       @unique
  lastRefundError   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
}

model NotificationDelivery {
  id            String             @id @default(cuid())
  dedupeKey     String             @unique
  channel       NotificationChannel
  recipient     String
  subject       String             @default("")
  body          String
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  claimedAt     DateTime?
  lastError     String?
  nextAttemptAt DateTime           @default(now())
  sentAt        DateTime?
  createdAt     DateTime           @default(now())

  @@index([status, nextAttemptAt])
}

model Review {
  id         String       @id @default(cuid())
  bookingId  String       @unique
  businessId String
  authorId   String
  rating     Int
  body       String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author     User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([businessId, status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}
